# Environment
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gt_dev?sslmode=disable"
DB_SSL=

# API
PORT=3001

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
# Set for cross-subdomain cookies (e.g. ".gajantraders.com" in production)
COOKIE_DOMAIN=

# Google OAuth (get credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 17TRACK
TRACK_API_KEY=your-17track-api-key
TRACK_WEBHOOK_SECRET=your-17track-webhook-secret

# Redis (local Docker: `docker run -p 6379:6379 redis:7-alpine`)
# Coolify: add a Redis service, get the internal URL
REDIS_URL="redis://localhost:6379"

# Email — ZeptoMail (primary)
ZEPTOMAIL_HOST="smtp.zeptomail.com"
ZEPTOMAIL_PORT=587
ZEPTOMAIL_USER="emailapikey"
ZEPTOMAIL_PASS="your-zepto-api-key"

# Email — SMTP fallback
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Default sender
DEFAULT_FROM_EMAIL="noreply@gajantraders.com"
DEFAULT_FROM_NAME="Gajan Traders"

# MSG91 / WhatsApp
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_WHATSAPP_SENDER="your-whatsapp-sender-number"
MSG91_TEMPLATE_ID_PICKEDUP="template_id_1"
MSG91_TEMPLATE_ID_INTRANSIT="template_id_2"
MSG91_TEMPLATE_ID_OUTFORDELIVERY="template_id_3"
MSG91_TEMPLATE_ID_DELIVERED="template_id_4"
MSG91_TEMPLATE_ID_EXCEPTION="template_id_5"

# Admin app
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Seed API superadmin creation
SEED_SECRET=
SEED_SUPERADMIN_EMAIL=juddan2008@gmail.com  # superadmin email (dev default)
SEED_SUPERADMIN_PASSWORD=                   # required for POST /api/seed/superadmin
SEED_SUPERADMIN_NAME=Super Admin            # superadmin display name (dev default)

# Archive / Cleanup (cron runs daily at 3 AM)
ARCHIVE_AFTER_DAYS=90          # Archive terminal shipments after N days
SKELETONIZE_AFTER_DAYS=365     # Clear tracking data after N days
PURGE_AFTER_DAYS=1460           # Delete records entirely after N days
