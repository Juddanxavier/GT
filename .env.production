# ── Environment ──
NODE_ENV=production

# ── Database ──
# REQUIRED: Use a production DB, NOT the dev Neon DB
DATABASE_URL="postgresql://user:password@prod-host:5432/gt_prod?sslmode=require"
DB_SSL=require

# ── API ──
PORT=3001

# ── Better Auth ──
# REQUIRED: Generate a unique secret per environment — NEVER reuse dev secrets in prod
#   openssl rand -base64 32
BETTER_AUTH_SECRET="uLlMq96RSNjlyMZCcUdfU+7p+DRD7k6rTUSxM6Hs03Y="
# REQUIRED: Must match the deployed API domain
BETTER_AUTH_URL="https://api.gajantraders.com"
# Cross-subdomain cookies between admin.gajantraders.com and api.gajantraders.com
COOKIE_DOMAIN=".gajantraders.com"

# ── Google OAuth ──
# Get credentials from Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Sentry ──
SENTRY_DSN="https://4691828135b99f440e6251cb4c7f8384@o406977.ingest.us.sentry.io/4511561466183680"

# ── Shipment Provider ──
SHIPMENT_PROVIDER=17track

# 17TRACK
TRACK_API_KEY="1047AE68B98FBBCC116277F00A9A1CD5"
TRACK_WEBHOOK_SECRET="WA849l0QRJB049XGAYcAnt3+EHtSDNhLsEtpf2/aR9g="

# TrackingMore (fallback)
TRACKINGMORE_API_KEY=""
TRACKINGMORE_WEBHOOK_SECRET=""

# ── Redis ──
# REQUIRED: Use Dokploy-managed Redis, Upstash, or Redis Cloud — NOT localhost
#   redis[s]://[:password@]host[:port][/db-number]
REDIS_URL=""

# ── Seed API (one-time superadmin creation) ──
# Change this: run `openssl rand -hex 32` to generate a new secret
SEED_SECRET="e2e3da55394fe44f3521269c83aa98640313a067d00286dfc83a0fe6232230c4"

# ── Email — ZeptoMail (primary, via SMTP) ──
# REQUIRED: set your ZeptoMail API key for password resets, 2FA, and notifications
ZEPTOMAIL_HOST="smtp.zeptomail.com"
ZEPTOMAIL_PORT=587
ZEPTOMAIL_USER="emailapikey"
ZEPTOMAIL_PASS=""

# ── Email — SMTP fallback (only if ZeptoMail is not set) ──
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""

# ── Default sender ──
DEFAULT_FROM_EMAIL="noreply@gajantraders.com"
DEFAULT_FROM_NAME="Gajan Traders"

# ── MSG91 / WhatsApp (shipment notifications) ──
MSG91_AUTH_KEY=""
MSG91_WHATSAPP_SENDER=""
MSG91_TEMPLATE_ID_PICKEDUP=""
MSG91_TEMPLATE_ID_INTRANSIT=""
MSG91_TEMPLATE_ID_OUTFORDELIVERY=""
MSG91_TEMPLATE_ID_DELIVERED=""
MSG91_TEMPLATE_ID_EXCEPTION=""

# ── CORS (list all frontend origins) ──
CORS_ORIGIN=https://admin.gajantraders.com,https://gajantraders.com,https://www.gajantraders.com

# ── Frontend (used during Docker build) ──
NEXT_PUBLIC_API_URL=https://api.gajantraders.com
