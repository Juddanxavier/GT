{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "experimentalScannerIgnores": [
      ".planning/**",
      "additional_parameters.json",
      "**/*.pdf",
      "apps/api/drizzle/**",
      "**/.next/**",
      "**/dist/**"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error",
        "useTemplate": "error"
      },
      "complexity": {
        "noForEach": "off",
        "noBannedTypes": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/admin/**", "**/apps/admin/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "warn",
            "noUnusedVariables": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn",
            "useIterableCallbackReturn": "warn"
          },
          "style": {
            "useTemplate": "warn"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          },
          "style": {
            "useTemplate": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noThenProperty": "off"
          }
        }
      }
    },
    {
      "includes": ["**/report-pdf.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/**/*.ts", "!apps/api/**/*.test.ts", "!apps/api/drizzle/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    }
  ]
}
